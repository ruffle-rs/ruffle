{
    "extends": "@tsconfig/strictest/tsconfig.json",
    "compilerOptions": {
        "composite": true,
        "module": "ESNext",
        "moduleResolution": "bundler",
        "target": "es2021",
        "rootDir": ".",
        "outDir": "dist",
        "types": ["node", "@wdio/globals/types", "@wdio/mocha-framework", "ruffle-core"]
    },
    "include": ["js/**/*", "test/**/*", "wdio.conf.ts", "build.ts"],
}
