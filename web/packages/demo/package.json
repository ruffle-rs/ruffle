{
    "name": "ruffle-demo",
    "version": "0.7.1",
    "description": "Demo of Ruffle Flash emulator",
    "license": "(MIT OR Apache-2.0)",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "build-local": "tsc && vite build --config vite.config.local.ts && vite build --config vite.config.local-patcher.ts && node src/local-patcher/inline-html.js",
        "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
        "preview": "vite preview",
        "checkTypes": "tsc --noemit"
    },
    "dependencies": {
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "ruffle-core": "^0.7.1"
    },
    "devDependencies": {
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "base85": "^3.2.0",
        "buffer": "^6.0.3",
        "html-minifier-terser": "^7.2.0",
        "jsdom": "^27.0.0",
        "typescript": "^6.0.3",
        "vite": "^8.3.4",
        "zlibjs": "^0.3.1"
    }
}
