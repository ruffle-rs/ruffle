// AVM1 bytecode in a DoAction tag.
Swf(
    version: 10,
    tags: [
        FileAttributes(),
        DoAction(Bytes([
            "96 07 00 00 68 65 6c 6c 6f 00", // Push "hello"
            "26",                            // Trace
            "00",                            // End
        ])),
        ShowFrame,
        End,
    ],
)
