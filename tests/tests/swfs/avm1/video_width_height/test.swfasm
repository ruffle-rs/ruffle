// See test.as.
Swf(
    version: 8,
    frame_rate: 12,
    tags: [
        FileAttributes(),
        SetBackgroundColor(0xFFFFFF),
        DoAction(Rascal(file: "test.as")),
        // DefineVideoStream: character 1, no frames, 160x120, no flags, no codec.
        Raw(code: 60, data: InlineBytes(["0100", "0000", "a000", "7800", "00", "00"])),
        PlaceObject2(
            depth: 1,
            character: 1,
            matrix: (translate_x: 190.95, translate_y: 147),
            name: "the_video",
        ),
        ShowFrame,
        End,
    ],
)
