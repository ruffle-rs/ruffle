                "01",                         // Flags: wide codes
                "01",                         // Language code
                "30 00 31 00 32 00 33 00",    // Code table "0123"
            ]),
        ),
        // Only DefineFont + DefineFontInfo2.
        // DefineFont 5
        Raw(
            code: 10,
