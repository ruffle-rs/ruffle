Swf(
    version: 8,
    tags: [
        // DefineFont + DefineFontInfo2, then DefineFont2 with the same name.
        // DefineFont 1
        Raw(
            code: 10,
            data: InlineBytes([
                "01 00",                   // Font ID
                "08 00 0a 00 0c 00 0e 00", // Offset table
                "10 00 10 00 10 00 10 00", // Empty glyph shapes
            ]),
        ),
        // DefineFontInfo2 for font 1
        Raw(
            code: 62,
            data: InlineBytes([
                "01 00",                   // Font ID
                "08",                      // Name length
                "54 65 73 74 46 6f 6e 74", // Name "TestFont"
                "01",                      // Flags: wide codes
                "01",                      // Language code
                "30 00 31 00 32 00 33 00", // Code table "0123"
            ]),
        ),
        // DefineFont2 2
        Raw(
            code: 48,
            data: InlineBytes([
                "02 00",                   // Font ID
                "84",                      // Flags: has layout, wide codes
                "00",                      // Language code
                "08",                      // Name length
                "54 65 73 74 46 6f 6e 74", // Name "TestFont"
                "04 00",                   // Glyph count
                "0a 00 0c 00 0e 00 10 00", // Offset table
                "12 00",                   // Code table offset
                "10 00 10 00 10 00 10 00", // Empty glyph shapes
                "30 00 31 00 32 00 33 00", // Code table "0123"
                "20 03 e0 00 00 00",       // Ascent, descent, leading
                "00 02 00 02 00 02 00 02", // Advances
                "00 00 00 00",             // Empty bounds
                "00 00",                   // Kerning count
            ]),
        ),
        // DefineFont2, then DefineFont + DefineFontInfo2 with the same name.
        // DefineFont2 3
        Raw(
            code: 48,
            data: InlineBytes([
                "03 00",                      // Font ID
                "84",                         // Flags: has layout, wide codes
                "00",                         // Language code
                "09",                         // Name length
                "54 65 73 74 46 6f 6e 74 32", // Name "TestFont2"
                "04 00",                      // Glyph count
                "0a 00 0c 00 0e 00 10 00",    // Offset table
                "12 00",                      // Code table offset
                "10 00 10 00 10 00 10 00",    // Empty glyph shapes
                "30 00 31 00 32 00 33 00",    // Code table "0123"
                "20 03 e0 00 00 00",          // Ascent, descent, leading
                "00 02 00 02 00 02 00 02",    // Advances
                "00 00 00 00",                // Empty bounds
                "00 00",                      // Kerning count
            ]),
        ),
