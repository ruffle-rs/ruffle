                "49 74 61 6c 69 63 32",    // Name "Italic2"
                "05",                      // Flags: wide codes, italic
                "01",                      // Language code
                "30 00 31 00 32 00 33 00", // Code table "0123"
            ]),
        ),
        // DefineFont2 7
        Raw(
            code: 48,
