// The root's frame script constructs clips and adds them to `c`, which comes
// later in the frame script traversal. `Early` and `UnlinkedEarly` add their
// frame script before calling `super()`, `Late` and `UnlinkedLate` after.
// `Early` and `Late` are linked to symbols with a timeline, the unlinked ones
// aren't. On which frame do their frame scripts first run, and do they run
// before or after the frame script of `d`, which comes after `c`?
Swf(
    version: 16,
    stage: (width: 100.0, height: 100.0),
    frame_rate: 24.0,
    tags: [
        FileAttributes(action_script_3: true),
        DefineSprite(id: 1, tags: [ShowFrame]),
        DefineSprite(id: 2, tags: [ShowFrame]),
        DefineSprite(id: 3, tags: [ShowFrame]),
        DefineSprite(id: 4, tags: [ShowFrame]),
        DoAbc(Asc(
            file: "Main.as",
            scripts: ["D.as", "Early.as", "Late.as", "UnlinkedEarly.as", "UnlinkedLate.as"],
        )),
        SymbolClass([
            (character: 0, name: "Main"),
            (character: 2, name: "Early"),
            (character: 3, name: "Late"),
            (character: 4, name: "D"),
        ]),
        PlaceObject2(depth: 1, character: 1, name: "c"),
        PlaceObject2(depth: 2, character: 4, name: "d"),
        ShowFrame,
        End,
    ],
)
